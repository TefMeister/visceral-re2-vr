--- a/src/REFramework.cpp
+++ b/src/REFramework.cpp
@@ -825,6 +825,36 @@ void REFramework::run_imgui_frame(bool from_present) {
     
     ImGui_ImplWin32_NewFrame();
 
+    // Visceral (RE2 VR), 2026-10-24: the menu text was squished in VR (Tefa 2026-10-11). On OpenXR the menu is never
+    // put in the headset; it is drawn onto the back buffer, which in VR is the eye size (2688x2880 on a Quest 3 via
+    // Virtual Desktop), and the window shows that back buffer shrunk into its own 16:9 client area. ImGui lays the menu
+    // out for the client size and drew it 1:1 into the back buffer's top-left corner, so the window's shrink flattened
+    // it. Scaling the draw to the whole back buffer (the framebuffer scale) lets the window's shrink undo it exactly:
+    // the menu shows at the window's own pixels, and the mouse, already in window pixels, lines up with no change.
+    // Not on OpenVR: its overlay reads the menu target and maps the laser in back buffer pixels.
+    {
+        auto& io = ImGui::GetIO();
+        io.DisplayFramebufferScale = ImVec2{1.0f, 1.0f};
+
+        const auto& vr = VR::get();
+        const auto is_d3d11 = m_renderer_type == RendererType::D3D11;
+        const auto rt_w = (float)(is_d3d11 ? m_d3d11.rt_width : m_d3d12.rt_width);
+        const auto rt_h = (float)(is_d3d11 ? m_d3d11.rt_height : m_d3d12.rt_height);
+
+        if (vr->is_ui_fit_window() && vr->is_hmd_active() && vr->get_runtime()->is_openxr() &&
+            rt_w > 0.0f && rt_h > 0.0f && io.DisplaySize.x > 0.0f && io.DisplaySize.y > 0.0f) {
+            io.DisplayFramebufferScale = ImVec2{rt_w / io.DisplaySize.x, rt_h / io.DisplaySize.y};
+        }
+
+        static ImVec2 s_logged_scale{1.0f, 1.0f};
+
+        if (std::abs(io.DisplayFramebufferScale.x - s_logged_scale.x) > 0.01f || std::abs(io.DisplayFramebufferScale.y - s_logged_scale.y) > 0.01f) {
+            s_logged_scale = io.DisplayFramebufferScale;
+            spdlog::info("[Visceral] menu drawn at scale {:.3f} x {:.3f} (window {}x{}, back buffer {}x{})",
+                s_logged_scale.x, s_logged_scale.y, (int)io.DisplaySize.x, (int)io.DisplaySize.y, (int)rt_w, (int)rt_h);
+        }
+    }
+
     // from_present is so we don't accidentally
     // run script/game code within the present thread.
     if (is_init_ok && !from_present) {
